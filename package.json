{
  "name": "pinpoint",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual review tool that turns element-specific client feedback into draft GitHub pull requests.",
  "bin": {
    "pinpoint": "dist/app/index.js"
  },
  "scripts": {
    "build:overlay": "node scripts/build-overlay.mjs",
    "dev": "node scripts/build-overlay.mjs && tsx src/app/index.ts",
    "build": "node scripts/build-overlay.mjs && tsc",
    "start": "node dist/app/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "element-source": "^0.0.5",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.7.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
